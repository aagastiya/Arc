# Supabase: Project Settings → API (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: Settings → API → service_role (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: protect POST /api/rss/sync and GET|POST /api/admin/cleanup in
# production (Bearer token). Vercel Cron sends Authorization: Bearer $CRON_SECRET
# — set the same value in the Vercel project env for weekly article cleanup.
CRON_SECRET=your-random-secret

# HTTP Basic Auth for /admin and /api/arc (middleware)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# OpenWeather (Today feed header) — https://openweathermap.org/api
NEXT_PUBLIC_OPENWEATHER_API_KEY=
